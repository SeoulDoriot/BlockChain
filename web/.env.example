# ---------------------------------------------------------------------------
# Public — these reach the browser. Never put a secret here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL of this app. Used to build the URL encoded in each QR code,
# so it must be the real public origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=80002

# Deployed CertificateRegistry address (filled in after Phase 5 deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Block explorer used for transaction links
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# ---------------------------------------------------------------------------
# Server only — never prefixed NEXT_PUBLIC_, never sent to the browser.
# ---------------------------------------------------------------------------

# Supabase service role key. Bypasses ALL row-level security. Treat as a
# root password for the database.
SUPABASE_SERVICE_ROLE_KEY=

# JSON-RPC endpoint for Polygon Amoy
RPC_URL=

# Private key of the wallet that signs issue/revoke transactions.
# Use a throwaway key funded only with testnet POL.
ISSUER_PRIVATE_KEY=

# SMTP credentials for sending certificate emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for the expiry-reminder cron route. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# --- Local development -------------------------------------------------------
# "local" uses a Hardhat node at RPC_URL (chain 31337); anything else uses Amoy.
NEXT_PUBLIC_CHAIN=amoy
# Direct Postgres connection, used only by local scripts.
SUPABASE_DB_URL=
# First admin account, created by `npm run local:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
